---
// Cinematic video poster. Starts slightly tilted and flattens as it scrolls into view.
// On click, the poster zooms into a centered theater view (3D) and the video plays there.
// Nothing loads from YouTube except the HD thumbnail until the visitor presses play.
interface Props { id: string; title: string; label?: string }
const { id, title, label = 'Watch: why SaaSNova exists' } = Astro.props;
const poster = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
const ld = {
  '@context': 'https://schema.org', '@type': 'VideoObject', name: title, description: title,
  thumbnailUrl: poster, embedUrl: `https://www.youtube-nocookie.com/embed/${id}`, contentUrl: `https://www.youtube.com/watch?v=${id}`,
};
---
<div class="cinema" data-cinema data-id={id} data-title={title}>
  <div class="stage3d">
    <button type="button" class="poster" aria-label={`Play video: ${title}`} aria-haspopup="dialog">
      <img src={poster} alt="" width="1280" height="720" fetchpriority="high" decoding="async" />
      <span class="shade" aria-hidden="true"></span>
      <span class="play" aria-hidden="true">
        <span class="disc"><svg viewBox="0 0 24 24"><path d="M8 5.2v13.6L19 12z" fill="currentColor"/></svg></span>
        <span class="lbl">{label}</span>
      </span>
    </button>
  </div>
  <dialog class="theater" aria-label={title}>
    <div class="frame" data-frame></div>
    <button type="button" class="close" aria-label="Close video" data-close>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
    </button>
  </dialog>
</div>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />

<style>
  .cinema { perspective: 1600px; }
  .stage3d { transform-origin: 50% 0%; transform: rotateX(12deg) scale(0.94); transition: transform 60ms linear; }
  @supports (animation-timeline: view()) {
    .stage3d { transform: none; animation: flatten linear both; animation-timeline: view(); animation-range: entry 0% cover 45%; }
    @keyframes flatten { from { transform: rotateX(14deg) scale(0.92); } to { transform: rotateX(0) scale(1); } }
  }
  @media (prefers-reduced-motion: reduce) { .stage3d { animation: none !important; transform: none !important; } }

  .poster {
    all: unset; cursor: pointer; position: relative; display: block; width: 100%;
    aspect-ratio: 16 / 9; border-radius: 28px; overflow: hidden; background: #0a0f24;
    box-shadow: 0 50px 100px -40px rgba(0, 45, 110, 0.55), 0 0 0 1px rgba(10, 15, 36, 0.08);
  }
  .poster:focus-visible { outline: 3px solid var(--blue); outline-offset: 6px; }
  .poster img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.02); transition: transform 900ms var(--ease); }
  .poster:hover img { transform: scale(1.05); }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10, 15, 36, 0) 60%, rgba(10, 15, 36, 0.45) 100%); }
  .play { position: absolute; left: clamp(1rem, 0.5rem + 2vw, 2rem); bottom: clamp(1rem, 0.5rem + 2vw, 2rem); display: flex; align-items: center; gap: 0.9rem; color: #fff; padding: 0.5rem 1.4rem 0.5rem 0.5rem; border-radius: 999px; background: rgba(10, 15, 36, 0.35); backdrop-filter: blur(14px) saturate(160%); -webkit-backdrop-filter: blur(14px) saturate(160%); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3); }
  .disc {
    width: clamp(3rem, 2.5rem + 1.5vw, 4rem); aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center;
    background: var(--nova-btn); box-shadow: 0 10px 24px -8px rgba(250, 15, 156, 0.6);
    transition: transform 300ms var(--ease), background 300ms;
  }
  .disc svg { width: 38%; margin-left: 8%; }
  .poster:hover .disc { transform: scale(1.08); }
  .lbl { font-weight: 650; font-size: clamp(0.9rem, 0.8rem + 0.4vw, 1.1rem); white-space: nowrap; }

  .theater {
    position: fixed; inset: 0; width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: transparent; overflow: hidden;
  }
  .theater::backdrop { background: rgba(6, 10, 28, 0.82); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .frame {
    position: absolute; left: 50%; top: 50%; width: min(92vw, calc(84vh * 16 / 9), 1400px); aspect-ratio: 16 / 9;
    translate: -50% -50%; border-radius: 22px; overflow: hidden; background: #000;
    box-shadow: 0 60px 120px -30px rgba(0, 0, 0, 0.7);
  }
  .frame :global(iframe), .frame :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: cover; }
  .close {
    position: absolute; right: clamp(1rem, 3vw, 2rem); top: clamp(1rem, 3vw, 2rem); width: 3rem; height: 3rem; border-radius: 50%;
    display: grid; place-items: center; border: 0; color: #fff; background: rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3);
  }
  .close:hover { background: rgba(255, 255, 255, 0.26); }
  .close svg { width: 1.3rem; height: 1.3rem; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cinema]').forEach((root) => {
    const poster = root.querySelector<HTMLButtonElement>('.poster')!;
    const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
    const frame = root.querySelector<HTMLElement>('[data-frame]')!;
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-close]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const img = poster.querySelector('img')!;

    // Fallback tilt for browsers without scroll-driven animations.
    const stage = root.querySelector<HTMLElement>('.stage3d')!;
    if (!CSS.supports('animation-timeline: view()') && !reduce) {
      const onScroll = () => {
        const r = root.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (window.innerHeight - r.top) / (window.innerHeight * 0.9)));
        stage.style.transform = `rotateX(${12 * (1 - p)}deg) scale(${0.94 + 0.06 * p})`;
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    // FLIP: animate the frame from the poster's rectangle to the center of the screen.
    const flip = (reverse = false) => {
      const from = poster.getBoundingClientRect();
      const to = frame.getBoundingClientRect();
      const dx = from.left + from.width / 2 - (to.left + to.width / 2);
      const dy = from.top + from.height / 2 - (to.top + to.height / 2);
      const s = from.width / to.width;
      const start = `translate(${dx}px, ${dy}px) scale(${s}) rotateX(10deg)`;
      const end = 'translate(0, 0) scale(1) rotateX(0deg)';
      return frame.animate(
        [{ transform: `perspective(1600px) ${reverse ? end : start}` }, { transform: `perspective(1600px) ${reverse ? start : end}` }],
        { duration: reduce ? 0 : reverse ? 380 : 620, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'both' },
      );
    };

    const open = () => {
      frame.replaceChildren(img.cloneNode(true));
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
      flip().finished.then(() => {
        const f = document.createElement('iframe');
        f.src = `https://www.youtube-nocookie.com/embed/${root.dataset.id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
        f.title = root.dataset.title || 'Video';
        f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        f.allowFullscreen = true;
        frame.append(f);
      });
      window.gtag?.('event', 'video_open', { video_id: root.dataset.id });
    };
    const close = () => {
      frame.querySelector('iframe')?.remove();
      flip(true).finished.then(() => {
        dialog.close();
        document.documentElement.style.overflow = '';
        frame.getAnimations().forEach((a) => a.cancel());
        frame.replaceChildren();
        poster.focus();
      });
    };
    poster.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    dialog.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) close(); });
  });
</script>
