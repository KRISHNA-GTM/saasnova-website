---
// Infographic: "Before" (dormant listing) → the SaaSNova execution engine (4 motions) → "After" (revenue).
// Pure HTML + inline SVG, responsive, animated gently (disabled under reduced motion).
const stages = [
  { n: '01', t: 'Activate', d: 'Field relationships' },
  { n: '02', t: 'Drive', d: 'Co-sell to deals' },
  { n: '03', t: 'Convert', d: 'Marketplace to revenue' },
  { n: '04', t: 'Prove', d: 'Board-ready evidence' },
];
const stats = [
  { v: 2000, pre: '', suf: '+', fmt: 'k', l: 'PSQLs', s: 'Arctic Wolf' },
  { v: 300, pre: '$', suf: 'K', fmt: '', l: 'MDF secured', s: 'Dataminr' },
  { v: 9, pre: '', suf: 'X', fmt: '', l: 'ROI', s: 'Arctic Wolf' },
  { v: 100, pre: '', suf: '+', fmt: '', l: 'ISVs activated', s: 'AWS, Azure, GCP' },
];
---
<div class="engine" data-engine>
  <div class="flow">
    <div class="card before">
      <p class="lbl"><span class="dot"></span>Before</p>
      <ul role="list">
        <li><span class="ic x" aria-hidden="true">✕</span>Listing live, zero co-sell</li>
        <li><span class="ic x" aria-hidden="true">✕</span>No field relationships</li>
        <li><span class="ic x" aria-hidden="true">✕</span>MDF sitting unclaimed</li>
      </ul>
      <p class="status">Status: Dormant</p>
    </div>

    <div class="pipe" aria-hidden="true"><span></span></div>

    <div class="core" role="img" aria-label="The SaaSNova execution engine: Activate, Drive, Convert, Prove">
      <svg viewBox="0 0 400 400" class="ring" aria-hidden="true">
        <defs>
          <linearGradient id="eg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#008BF8"/><stop offset=".5" stop-color="#7A4DFF"/><stop offset="1" stop-color="#FA0F9C"/></linearGradient>
          <radialGradient id="eglow"><stop offset="0" stop-color="#FA0F9C" stop-opacity=".25"/><stop offset="1" stop-color="#008BF8" stop-opacity="0"/></radialGradient>
        </defs>
        <circle cx="200" cy="200" r="190" fill="url(#eglow)"/>
        <circle cx="200" cy="200" r="150" fill="none" stroke="#E1E7F1" stroke-width="2"/>
        <circle class="spin" cx="200" cy="200" r="150" fill="none" stroke="url(#eg)" stroke-width="6" stroke-linecap="round" stroke-dasharray="120 60"/>
        <circle cx="200" cy="200" r="108" fill="#060A1C"/>
        <path d="M200 128l8 36 36 8-36 8-8 36-8-36-36-8 36-8z" fill="url(#eg)"/>
      </svg>
      <p class="core-t"><span>SaaSNova</span> execution engine</p>
      {stages.map((s, i) => (
        <div class:list={['node', `n${i}`]}><span class="nn">{s.n}</span><strong>{s.t}</strong><span class="nd">{s.d}</span></div>
      ))}
    </div>

    <div class="pipe" aria-hidden="true"><span></span></div>

    <div class="card after">
      <p class="lbl"><span class="dot"></span>After</p>
      <ul role="list">
        <li><span class="ic ok" aria-hidden="true">✓</span>Active co-sell pipeline</li>
        <li><span class="ic ok" aria-hidden="true">✓</span>Field relationships active</li>
        <li><span class="ic ok" aria-hidden="true">✓</span>MDF unlocked and used</li>
      </ul>
      <p class="status">Status: Operational</p>
    </div>
  </div>

  <dl class="stats">
    {stats.map((s) => (
      <div>
        <dt class="num" data-count={s.v} data-pre={s.pre} data-suf={s.suf} data-fmt={s.fmt}>{s.pre}{s.fmt === 'k' ? `${s.v / 1000}K` : s.v}{s.suf}</dt>
        <dd><strong>{s.l}</strong>{s.s}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .engine { display: grid; gap: 2rem; }
  .flow { display: grid; gap: 1rem; align-items: center; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 64rem) { .flow { grid-template-columns: 1fr 3rem minmax(22rem, 1.25fr) 3rem 1fr; gap: 0.5rem; } }
  .card { padding: 1.5rem; border-radius: var(--r-lg); background: #fff; border: 1.5px solid; box-shadow: var(--shadow); }
  .before { border-color: #ffc9e5; }
  .after { border-color: #b9e0ff; }
  .lbl { display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem; }
  .before .lbl { color: var(--pink-ink); }
  .after .lbl { color: var(--blue-ink); }
  .dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 4px color-mix(in srgb, currentColor 18%, transparent); }
  .card ul { display: grid; gap: 0.75rem; }
  .card li { display: flex; gap: 0.65rem; align-items: center; font-weight: 600; color: var(--ink); font-size: 0.975rem; }
  .ic { width: 1.5rem; height: 1.5rem; flex: none; border-radius: 50%; display: grid; place-items: center; font-size: 0.75rem; font-weight: 900; }
  .x { background: #ffe3f1; color: var(--pink-ink); }
  .ok { background: #dcf0ff; color: var(--blue-ink); }
  .status { margin-top: 1.1rem; display: inline-block; font-family: ui-monospace, Consolas, monospace; font-size: 0.8125rem; font-weight: 700; padding: 0.35rem 0.6rem; border-radius: 6px; }
  .before .status { background: #ffe3f1; color: var(--pink-ink); }
  .after .status { background: #dcf0ff; color: var(--blue-deep); }

  .pipe { height: 3rem; width: 4px; margin-inline: auto; background: var(--line); border-radius: 4px; overflow: hidden; position: relative; }
  @media (min-width: 64rem) { .pipe { height: 4px; width: 100%; } }
  .pipe span { position: absolute; inset: 0; background: linear-gradient(90deg, transparent, #7a4dff, transparent); animation: flowY 1.8s linear infinite; }
  @media (min-width: 64rem) { .pipe span { animation-name: flowX; } }
  @keyframes flowX { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
  @keyframes flowY { from { transform: translateY(-100%); } to { transform: translateY(100%); } }

  .core { position: relative; width: min(100%, 26rem); aspect-ratio: 1; margin-inline: auto; }
  .ring { width: 100%; height: 100%; }
  .spin { transform-origin: 200px 200px; animation: rot 14s linear infinite; }
  @keyframes rot { to { transform: rotate(360deg); } }
  .core-t { position: absolute; left: 50%; top: 57%; translate: -50% 0; text-align: center; color: #b4bfd8; font-size: clamp(0.6rem, 0.5rem + 0.4vw, 0.75rem); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.3; width: 8rem; }
  .core-t span { display: block; color: #fff; font-size: 1.35em; letter-spacing: 0; text-transform: none; }
  .node { position: absolute; display: grid; justify-items: center; text-align: center; gap: 0.05rem; width: 8.5rem; padding: 0.55rem 0.6rem; border-radius: var(--r-md); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow); translate: -50% -50%; }
  .node strong { font-size: 0.95rem; color: var(--ink); letter-spacing: -0.01em; }
  .nn { font-size: 0.7rem; font-weight: 800; background: var(--nova); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nd { font-size: 0.75rem; color: var(--muted); line-height: 1.3; }
  .n0 { left: 50%; top: 12.5%; }
  .n1 { left: 87.5%; top: 50%; }
  .n2 { left: 50%; top: 87.5%; }
  .n3 { left: 12.5%; top: 50%; }
  @media (max-width: 30rem) { .node { width: 6.5rem; padding: 0.4rem; } .nd { display: none; } }

  .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  @media (min-width: 48rem) { .stats { grid-template-columns: repeat(4, 1fr); } }
  .stats div { padding: 1.25rem; border-radius: var(--r-lg); background: #fff; border: 1px solid var(--line); text-align: center; }
  .stats dt { font-size: clamp(2.2rem, 1.6rem + 2vw, 3.2rem); font-weight: 900; letter-spacing: -0.05em; line-height: 1; background: var(--nova); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .stats dd { margin: 0.5rem 0 0; font-size: 0.85rem; color: var(--muted); display: grid; }
  .stats dd strong { color: var(--ink); font-size: 0.95rem; }

  @media (prefers-reduced-motion: reduce) { .spin, .pipe span { animation: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-engine] [data-count]').forEach((el) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    const v = Number(el.dataset.count);
    const show = (n: number) => {
      const body = el.dataset.fmt === 'k' ? `${(n / 1000).toFixed(n >= v ? 0 : 1)}K` : String(Math.round(n));
      el.textContent = `${el.dataset.pre ?? ''}${body}${el.dataset.suf ?? ''}`;
    };
    const io = new IntersectionObserver(([en]) => {
      if (!en.isIntersecting) return;
      io.disconnect();
      const t0 = performance.now();
      const tick = (t: number) => {
        const p = Math.min(1, (t - t0) / 1400);
        show(v * (1 - Math.pow(1 - p, 3)));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }, { threshold: 0.6 });
    io.observe(el);
  });
</script>
