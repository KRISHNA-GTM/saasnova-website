---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 1.5rem; align-items: baseline;
    padding: 1.15rem 0; font-weight: 600; color: var(--ink); font-size: 1.0625rem;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: ''; flex: none; width: 0.6rem; height: 0.6rem; margin-right: 0.3rem;
    border-right: 2px solid var(--blue); border-bottom: 2px solid var(--blue); transform: rotate(45deg) translateY(-0.2rem);
    transition: transform 180ms var(--ease);
  }
  details[open] summary::after { transform: rotate(-135deg) translateY(-0.1rem); }
  summary:hover span { color: var(--blue); }
  details p { padding: 0 2rem 1.25rem 0; color: var(--muted); max-width: 44rem; }
</style>
