---
// Ignite, SuperNova and NovaX as one comparison panel (three columns on one surface).
// Content comes from `flagship` in src/data/offerings.ts.
import { programs, offeringPath } from '../data/offerings';

interface Props { dark?: boolean; headingLevel?: 'h2' | 'h3' }
const { dark = true, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const accents: Record<string, string> = {
  ignite: 'linear-gradient(90deg,#F19953,#FA0F9C)',
  supernova: 'linear-gradient(90deg,#008BF8,#FA0F9C)',
  novax: 'linear-gradient(90deg,#008BF8,#8A5CFF)',
};
---
<div class:list={['panel-p', { dark }]}>
  {programs.map((p) => {
    const f = p.flagship!;
    return (
      <article class="col" style={`--accent:${accents[p.slug]}`}>
        <span class="bar" aria-hidden="true"></span>
        <p class="tagline">{f.tagline}</p>
        <H class="name"><a href={offeringPath(p)}>{p.short}</a></H>
        <dl class="facts">
          <div><dt>Duration</dt><dd>{p.duration}</dd></div>
          <div><dt>Stage</dt><dd>{f.stageRange}</dd></div>
        </dl>
        <p class="ideal">{f.idealStage}</p>

        <p class="label">What you get</p>
        <ul role="list" class="get">{f.whatYouGet.map((x) => <li>{x}</li>)}</ul>

        <p class="label">Impact</p>
        <ul role="list" class="impact">{f.impact.map((x) => <li>{x}</li>)}</ul>

        <a class="more" href={offeringPath(p)}>Explore {p.short}</a>
      </article>
    );
  })}
</div>

<style>
  .panel-p {
    display: grid; grid-template-columns: minmax(0, 1fr);
    background: #fff; border-radius: 32px; overflow: hidden;
    box-shadow: 0 40px 90px -50px rgba(0, 30, 80, 0.45); color: var(--text);
    border: 1px solid var(--line);
  }
  @media (min-width: 64rem) { .panel-p { grid-template-columns: repeat(3, 1fr); } }
  .col { position: relative; display: flex; flex-direction: column; padding: clamp(2rem, 1.5rem + 1.5vw, 2.75rem); }
  .col + .col { border-top: 1px solid var(--line); }
  @media (min-width: 64rem) { .col + .col { border-top: 0; border-left: 1px solid var(--line); } }
  .bar { position: absolute; left: 0; right: 0; top: 0; height: 6px; background: var(--accent); }
  .col .tagline { font-weight: 650; font-size: 1rem; color: var(--muted); }
  .name { font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem); font-weight: 800; letter-spacing: -0.05em; line-height: 1.05; margin: 0.4rem 0 1.5rem; padding-bottom: 0.05em; }
  .col .name a { text-decoration: none; background: var(--accent); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent; }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 0 2rem; }
  .facts div { display: grid; gap: 0.1rem; }
  .facts dt { font-size: 0.8125rem; color: var(--subtle); }
  .facts dd { margin: 0; font-weight: 700; color: var(--ink); font-size: 1rem; }
  .col .ideal { margin-top: 1rem; color: var(--muted); font-size: 0.975rem; min-height: 3em; }
  .col .label { margin-top: 1.75rem; margin-bottom: 0.75rem; font-size: 0.9rem; font-weight: 700; color: var(--ink); }
  .get, .impact { display: grid; gap: 0.55rem; font-size: 0.95rem; }
  .get li { position: relative; padding-left: 1.4rem; color: var(--text); }
  .get li::before { content: ''; position: absolute; left: 0.2rem; top: 0.3em; width: 0.4rem; height: 0.75rem; border-right: 2px solid var(--blue-ink); border-bottom: 2px solid var(--blue-ink); transform: rotate(40deg); }
  .impact li { padding: 0.6rem 0.8rem; border-radius: 12px; background: var(--mist); font-weight: 700; color: var(--ink); letter-spacing: -0.01em; }
  .col a.more { margin-top: auto; padding-top: 2rem; font-weight: 700; color: var(--blue-ink); text-decoration: none; }
  .col a.more:hover { text-decoration: underline; text-underline-offset: 0.25em; }
</style>
