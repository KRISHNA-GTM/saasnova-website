---
// Right-hand visual for interior page heroes, so no page opens with an empty half.
//   images: one or two photos (two are shown as an overlapping pair)
//   logos:  a wall of logo tiles
//   neither: the SaaSNova brand graphic (star + AWS, Azure, Google Cloud)
import { Image } from 'astro:assets';
import awsLogo from '../assets/images/aws-logo.png';
import azureLogo from '../assets/images/azure-logo.png';
import gcpLogo from '../assets/images/gcp-logo.png';

interface Pic { src: ImageMetadata | string; alt: string; position?: string }
interface Props { images?: Pic[]; logos?: { name: string; src: ImageMetadata; scale?: number }[]; caption?: string }
const { images = [], logos = [], caption } = Astro.props;
const isMeta = (s: ImageMetadata | string): s is ImageMetadata => typeof s !== 'string';
---
<div class:list={['art', images.length === 2 && 'pair', images.length === 1 && 'single', logos.length && 'wall', !images.length && !logos.length && 'brand']} aria-hidden={!images.length && !logos.length ? 'true' : undefined}>
  {images.map((p, i) => (
    <figure class={`ph ph${i}`}>
      {isMeta(p.src)
        ? <Image src={p.src} alt={p.alt} widths={[480, 800, 1100]} sizes="(min-width: 64rem) 40vw, 90vw" style={p.position ? `object-position:${p.position}` : undefined} loading="eager" />
        : <img src={p.src} alt={p.alt} width="1600" height="900" style={p.position ? `object-position:${p.position}` : undefined} />}
    </figure>
  ))}
  {logos.length > 0 && (
    <ul role="list" class="tiles">
      {logos.map((l) => <li><Image src={l.src} alt={l.name} height={Math.round(80 * (l.scale ?? 1))} style={`height:${Math.round(40 * (l.scale ?? 1))}px`} /></li>)}
    </ul>
  )}
  {!images.length && !logos.length && (
    <div class="brand-art">
      <svg class="star" viewBox="0 0 200 200"><defs><linearGradient id="ha" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#008BF8"/><stop offset=".55" stop-color="#8A5CFF"/><stop offset="1" stop-color="#FA0F9C"/></linearGradient></defs><path d="M100 8l13 79 79 13-79 13-13 79-13-79-79-13 79-13z" fill="url(#ha)"/></svg>
      <span class="chip c1"><Image src={awsLogo} alt="" height={56} /></span>
      <span class="chip c2"><Image src={azureLogo} alt="" height={56} />Azure</span>
      <span class="chip c3"><Image src={gcpLogo} alt="" height={56} />Google Cloud</span>
    </div>
  )}
  {caption && <p class="cap">{caption}</p>}
</div>

<style>
  .art { position: relative; width: 100%; }
  .art::before { content: ''; position: absolute; inset: 8% 4% -4% 8%; z-index: -1; border-radius: 40px; filter: blur(40px);
    background: radial-gradient(60% 60% at 30% 40%, rgba(0, 139, 248, 0.35), transparent 70%), radial-gradient(50% 50% at 80% 70%, rgba(250, 15, 156, 0.3), transparent 70%); }
  .ph { margin: 0; border-radius: 28px; overflow: hidden; background: var(--mist-2); box-shadow: 0 40px 80px -40px rgba(0, 40, 100, 0.5); border: 6px solid #fff; }
  .ph :global(img), .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .single .ph { aspect-ratio: 4 / 3; }
  .pair { display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: center; }
  .pair .ph0 { aspect-ratio: 3 / 4; grid-column: 1; grid-row: 1; }
  .pair .ph1 { aspect-ratio: 4 / 3; grid-column: 2; grid-row: 1; margin-left: -18%; margin-top: 30%; z-index: 1; }
  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.9rem; }
  .tiles li { aspect-ratio: 3 / 2; display: grid; place-items: center; padding: 1rem; background: #fff; border-radius: 20px; border: 1px solid var(--line); box-shadow: 0 20px 40px -28px rgba(0, 40, 100, 0.45); }
  .tiles :global(img) { width: auto; max-width: 100%; max-height: 100%; object-fit: contain; }
  .wall:has(.tiles li:nth-child(4):last-child) .tiles { grid-template-columns: repeat(2, 1fr); }
  .brand-art { position: relative; aspect-ratio: 5 / 4; }
  .star { position: absolute; left: 50%; top: 50%; width: 62%; translate: -50% -50%; filter: drop-shadow(0 30px 50px rgba(138, 92, 255, 0.35)); }
  .chip { position: absolute; display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.7rem 1.1rem; border-radius: 999px; background: #fff; box-shadow: 0 20px 40px -20px rgba(0, 40, 100, 0.45); font-weight: 700; color: var(--ink); white-space: nowrap; }
  .chip :global(img) { height: 26px; width: auto; }
  .c1 { left: 4%; top: 14%; }
  .c2 { right: 2%; top: 40%; }
  .c3 { left: 12%; bottom: 10%; }
  .cap { margin-top: 1rem; font-size: 0.9rem; color: var(--muted); text-align: center; }
  @media (max-width: 63.99rem) { .brand-art { display: none; } .art.brand { display: none; } }
</style>
