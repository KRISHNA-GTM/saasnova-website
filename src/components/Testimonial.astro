---
// A single quote block. Pass a quote from src/data/testimonials.ts (quotesFor(page)).
import { Image } from 'astro:assets';

interface Props {
  q: { quote: string; name: string; title: string; company: string; logo: ImageMetadata };
  variant?: 'featured' | 'standard';
  dark?: boolean;
}
const { q, variant = 'standard', dark = false } = Astro.props;
const initials = q.name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---
<figure class:list={['t', `t-${variant}`, { dark }]}>
  <svg class="mark" viewBox="0 0 48 36" aria-hidden="true"><path d="M0 36V21.6C0 9.9 6.2 2.7 18.6 0l2.1 4.6C14 6.9 10.8 11 10.5 17h9.3v19H0Zm27.2 0V21.6C27.2 9.9 33.4 2.7 45.8 0L48 4.6c-6.7 2.3-9.9 6.4-10.2 12.4h9.3v19H27.2Z" fill="url(#qg)"/><defs><linearGradient id="qg" x1="0" x2="48" y1="0" y2="36" gradientUnits="userSpaceOnUse"><stop stop-color="#008BF8"/><stop offset="1" stop-color="#FA0F9C"/></linearGradient></defs></svg>
  <blockquote><p>{q.quote}</p></blockquote>
  <figcaption>
    <span class="avatar" aria-hidden="true">{initials}</span>
    <span class="who"><strong>{q.name}</strong><span>{q.title}</span></span>
    <span class="logo-wrap"><Image src={q.logo} alt={`${q.company} logo`} height={30} /></span>
  </figcaption>
</figure>

<style>
  .t { margin: 0; display: grid; gap: 1.25rem; padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem); border-radius: var(--r-lg); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-sm); }
  .mark { width: 2.4rem; height: auto; }
  blockquote p { color: var(--ink); font-size: 1.125rem; line-height: 1.6; font-weight: 450; }
  .t-featured blockquote p { font-size: clamp(1.2rem, 1rem + 0.7vw, 1.5rem); line-height: 1.5; font-weight: 500; letter-spacing: -0.01em; }
  figcaption { display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap; padding-top: 1.1rem; border-top: 1px solid var(--line); }
  .avatar { width: 2.75rem; height: 2.75rem; border-radius: 50%; display: grid; place-items: center; background: var(--nova); color: #fff; font-weight: 750; font-size: 0.95rem; flex: none; }
  .who { display: grid; line-height: 1.35; font-size: 0.9375rem; margin-right: auto; }
  .who strong { color: var(--ink); }
  .who span { color: var(--muted); }
  .logo-wrap :global(img) { height: 30px; width: auto; max-width: 130px; object-fit: contain; }
  .dark { background: rgba(255, 255, 255, 0.04); border-color: var(--on-ink-line); box-shadow: none; }
  .dark blockquote p, .dark .who strong { color: #fff; }
  .dark .who span { color: var(--on-ink-muted); }
  .dark figcaption { border-color: var(--on-ink-line); }
  .dark .logo-wrap { background: #fff; padding: 0.4rem 0.7rem; border-radius: var(--r-sm); }
</style>
