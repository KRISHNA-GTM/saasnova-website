---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-color.png';
import { mainNav } from '../data/nav';
import { primaryCta } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string, groups?: { links: { href: string }[] }[]) =>
  path === href ||
  (href !== '/' && path.startsWith(href + '/')) ||
  !!groups?.some((g) => g.links.some((l) => path === l.href || (l.href !== '/' && path.startsWith(l.href + '/'))));
---
<header class="site-header" data-header>
  <div class="shell">
    <div class="bar">
      <a href="/" class="brand" aria-label="SaaSNova home">
        <Image src={logo} alt="SaaSNova, women-owned business" width={190} height={60} loading="eager" fetchpriority="high" />
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="visually-hidden">Menu</span>
      </button>

      <nav id="site-nav" class="nav" aria-label="Main" data-nav>
        <ul class="nav-list" role="list">
          {mainNav.map((item, i) => (
            <li class:list={['nav-item', { 'has-panel': item.groups, wide: item.wide }]}>
              {item.groups ? (
                <>
                  <button
                    type="button"
                    class:list={['nav-trigger', { active: isActive(item.href, item.groups) }]}
                    aria-expanded="false"
                    aria-controls={`panel-${i}`}
                    data-trigger
                  >
                    {item.label}
                    <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                  <div class="panel-drop" id={`panel-${i}`} hidden data-panel>
                    <div class="panel-grid">
                      {item.groups.map((g) => (
                        <div class:list={['panel-group', { featured: g.featured }]}>
                          {g.title && <p class="panel-title">{g.title}</p>}
                          <ul role="list">
                            {g.links.map((l) => (
                              <li>
                                <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
                                  <span class="pl">{l.label}</span>
                                  {l.desc && <span class="pd">{l.desc}</span>}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                    {item.footer && <a class="panel-footer link-arrow" href={item.footer.href}>{item.footer.label}</a>}
                  </div>
                </>
              ) : (
                <a
                  href={item.href}
                  class:list={['nav-link', { active: item.href === '/' ? path === '/' : isActive(item.href) }]}
                  aria-current={path === item.href ? 'page' : undefined}
                >{item.label}</a>
              )}
            </li>
          ))}
        </ul>
        <a class="btn btn-sm get-started" href={primaryCta.href} target="_blank" rel="noopener" data-track="cta_strategy_header">{primaryCta.short}</a>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; padding-top: 0.75rem; transition: padding 220ms var(--ease); }
  .shell { width: min(100% - 2 * var(--gutter), 84rem); margin-inline: auto; }
  .bar {
    display: flex; align-items: center; gap: 1.25rem; min-height: 4.5rem; padding: 0 0.75rem 0 1.5rem;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border: 1px solid rgba(225, 231, 241, 0.9); border-radius: 999px;
    box-shadow: 0 8px 30px -18px rgba(10, 17, 40, 0.25);
    transition: box-shadow 220ms var(--ease), background 220ms var(--ease);
  }
  .site-header.scrolled .bar { background: rgba(255, 255, 255, 0.95); box-shadow: 0 14px 40px -18px rgba(10, 17, 40, 0.35); }
  .brand { display: inline-flex; flex: none; }
  .brand :global(img) { width: 168px; height: auto; }

  .nav { display: flex; align-items: center; gap: 1rem; margin-left: auto; }
  .nav-list { display: flex; align-items: center; gap: 0.1rem; }
  .nav-item { position: relative; }
  .nav-trigger, .nav-link {
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.6rem 0.85rem; border-radius: 999px;
    background: none; border: 0; color: var(--text); font-weight: 550; font-size: 0.975rem;
    text-decoration: none; line-height: 1.2; transition: background 160ms, color 160ms;
  }
  .nav-trigger svg { width: 0.75rem; height: 0.75rem; transition: transform 160ms var(--ease); }
  .nav-trigger[aria-expanded='true'] svg { transform: rotate(180deg); }
  .nav-trigger:hover, .nav-link:hover, .nav-trigger[aria-expanded='true'] { background: var(--mist-2); color: var(--ink); }
  .active { background: var(--blue-50); color: var(--blue-ink); font-weight: 650; }
  .get-started { min-width: 8.5rem; }

  .panel-drop {
    position: absolute; top: calc(100% + 0.9rem); left: -0.5rem; min-width: 19rem;
    background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg);
    box-shadow: var(--shadow-lg); padding: 1rem;
  }
  .panel-drop::before { content: ''; position: absolute; left: 0; right: 0; top: -1rem; height: 1rem; }
  .wide .panel-drop { width: min(58rem, calc(100vw - 2rem)); left: 50%; transform: translateX(-30%); padding: 1.1rem; }
  .panel-grid { display: grid; gap: 1rem 1.25rem; }
  .wide .panel-grid { grid-template-columns: 1.15fr 1fr 1fr; }
  .panel-title { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--subtle); margin: 0.35rem 0 0.5rem 0.7rem; }
  .panel-group a {
    display: grid; gap: 0.1rem; padding: 0.55rem 0.7rem; border-radius: var(--r-sm);
    text-decoration: none; color: var(--ink); transition: background 140ms;
  }
  .panel-group a:hover, .panel-group a[aria-current='page'] { background: var(--mist); }
  .pl { font-weight: 650; font-size: 0.95rem; }
  .pd { font-size: 0.8125rem; color: var(--muted); }
  .featured { background: linear-gradient(160deg, var(--blue-50), var(--pink-50)); border-radius: var(--r-md); padding: 0.5rem; }
  .featured .panel-title { color: var(--pink-ink); }
  .featured ul { display: grid; gap: 0.4rem; }
  .featured a { background: #fff; box-shadow: var(--shadow-sm); padding: 0.75rem 0.9rem; }
  .featured a:hover { background: #fff; box-shadow: var(--shadow); }
  .featured .pl { font-size: 1.05rem; font-weight: 750; }
  .panel-footer { display: inline-flex; margin: 0.85rem 0 0.25rem 0.7rem; font-size: 0.9375rem; }

  .menu-toggle { display: none; }

  @media (max-width: 79.99rem) {
    .nav-trigger, .nav-link { padding-inline: 0.6rem; font-size: 0.94rem; }
    .brand :global(img) { width: 150px; }
  }

  @media (max-width: 67.99rem) {
    .site-header { padding-top: 0.5rem; }
    .bar { min-height: 4rem; padding: 0 0.5rem 0 1.1rem; }
    .brand :global(img) { width: 140px; }
    .menu-toggle {
      display: inline-grid; place-items: center; margin-left: auto;
      width: 2.9rem; height: 2.9rem; border: 1px solid var(--line); border-radius: 50%; background: #fff;
    }
    .bars { display: grid; gap: 4px; }
    .bars span { width: 18px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform 180ms var(--ease), opacity 180ms; }
    .menu-toggle[aria-expanded='true'] .bars span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .menu-toggle[aria-expanded='true'] .bars span:nth-child(2) { opacity: 0; }
    .menu-toggle[aria-expanded='true'] .bars span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

    .nav {
      position: fixed; inset: 5rem 0.75rem auto 0.75rem; max-height: calc(100dvh - 6rem); background: #fff; margin: 0;
      flex-direction: column; align-items: stretch; gap: 0; border-radius: var(--r-lg); box-shadow: var(--shadow-lg);
      padding: 0.75rem 1.1rem 1.25rem; overflow-y: auto; border: 1px solid var(--line);
      display: none;
    }
    .nav.open { display: flex; }
    .nav-list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-item { border-bottom: 1px solid var(--line); }
    .nav-trigger, .nav-link { width: 100%; justify-content: space-between; padding: 0.95rem 0.25rem; font-size: 1.0625rem; border-radius: 0; }
    .active { background: none; }
    .panel-drop, .wide .panel-drop {
      position: static; transform: none; width: auto; min-width: 0; border: 0; box-shadow: none;
      padding: 0 0 0.9rem 0; border-radius: 0;
    }
    .wide .panel-grid { grid-template-columns: 1fr; }
    .get-started { margin-top: 1.1rem; width: 100%; min-height: 3.1rem; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-trigger]'));

  const closeAll = (except?: HTMLButtonElement) => {
    triggers.forEach((t) => {
      if (t === except) return;
      t.setAttribute('aria-expanded', 'false');
      const p = document.getElementById(t.getAttribute('aria-controls')!);
      if (p) p.hidden = true;
    });
  };

  triggers.forEach((t) => {
    const panel = document.getElementById(t.getAttribute('aria-controls')!)!;
    t.addEventListener('click', () => {
      const open = t.getAttribute('aria-expanded') === 'true';
      closeAll(t);
      t.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
    const li = t.closest('li')!;
    let timer: number | undefined;
    const desktop = window.matchMedia('(min-width: 68rem) and (hover: hover)');
    li.addEventListener('mouseenter', () => {
      if (!desktop.matches) return;
      window.clearTimeout(timer);
      closeAll(t);
      t.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
    });
    li.addEventListener('mouseleave', () => {
      if (!desktop.matches) return;
      timer = window.setTimeout(() => {
        t.setAttribute('aria-expanded', 'false');
        panel.hidden = true;
      }, 180);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = triggers.find((t) => t.getAttribute('aria-expanded') === 'true');
    if (open) { closeAll(); open.focus(); return; }
    if (nav?.classList.contains('open')) { setMenu(false); toggle?.focus(); }
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.nav-item')) closeAll();
  });

  const setMenu = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  window.matchMedia('(min-width: 68rem)').addEventListener('change', (m) => { if (m.matches) setMenu(false); });

  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
