<script>
  // Count-up numbers (2K+, $300K, 9X, 100+) when the stats scroll into view.
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = (n: number, el: HTMLElement) => {
    const target = Number(el.dataset.count);
    const text = target >= 1000 ? `${Math.round(n / 100) / 10}K` : String(Math.round(n));
    return `${el.dataset.prefix ?? ''}${text}${el.dataset.suffix ?? ''}`;
  };
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => entries.forEach((en) => {
      if (!en.isIntersecting) return;
      const el = en.target as HTMLElement;
      io.unobserve(el);
      const target = Number(el.dataset.count);
      const t0 = performance.now();
      const tick = (t: number) => {
        const p = Math.min(1, (t - t0) / 1400);
        el.textContent = fmt(target * (1 - Math.pow(1 - p, 3)), el);
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }), { threshold: 0.6 });
    nums.forEach((n) => io.observe(n));
  }
</script>
