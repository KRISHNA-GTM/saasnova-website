---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TestimonialWall from '../components/TestimonialWall.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import ProgramCards from '../components/ProgramCards.astro';
import ProgramFinder from '../components/ProgramFinder.astro';
import CtaBand from '../components/CtaBand.astro';
import YouTube from '../components/YouTube.astro';
import advancedBadge from '../assets/images/SaaSNova-AWS-Advanced-Tier-badge.png';
import aiBadge from '../assets/images/SaaSNova-AWS-AI-Service-Competency-partner-badge.png';
import awsLogo from '../assets/images/aws-logo.png';
import azureLogo from '../assets/images/azure-logo.png';
import gcpLogo from '../assets/images/gcp-logo.png';
import jenStage from '../assets/images/jen-stage.png';
import jenPhoto from '../assets/images/jen-dp.jpg';
import rsac from '../assets/images/rsac-ss.jpeg';
import reinvent from '../assets/images/jen-dawson.jpg';
import speaking from '../assets/images/jen-speaking.png';
import storefrontBanner from '../assets/images/fq-storefront.jpg';
import { customerLogos, storefrontLogos } from '../data/logos';
import { services, offeringPath } from '../data/offerings';
import { trackRecord } from '../data/track-record';
import { primaryCta, site } from '../data/site';
import { g2ReviewUrl } from '../data/testimonials';

const heroVideo = 'x75hrIBKPj8';
const insights = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const moves = [
  { verb: 'Activate', title: 'Cloud field relationships', body: 'We build the AE, PDM and partner manager relationships at AWS, Microsoft and Google Cloud that make co-sell work: human trust, not just portal registrations.', outcome: 'Named field contacts who respond', color: 'var(--blue)' },
  { verb: 'Drive', title: 'Co-sell to actual deals', body: 'We run the co-sell motion end to end: opportunity identification, field engagement, deal validation and revenue attribution. Not just filed. Followed through.', outcome: 'Attributable cloud-sourced deals', color: '#7a4dff' },
  { verb: 'Convert', title: 'Marketplace presence to revenue', body: 'Co-marketing alignment, MDF, field enablement sessions and private offers, coordinated to turn marketplace activity into closed-won deals.', outcome: 'Repeatable deal flow', color: 'var(--pink)' },
  { verb: 'Prove', title: 'Revenue evidence for your board', body: 'Co-sell logs, field-validated deal evidence, revenue attribution and field relationship maps your board and investors can use directly.', outcome: 'A board-ready GTM ROI story', color: 'var(--orange)' },
];

const clouds = [
  { name: 'AWS', logo: awsLogo, items: ['AWS Marketplace listings and storefronts', 'ACE co-sell and ISV Accelerate', 'Partner Central, PRM and BOX funding'] },
  { name: 'Microsoft Azure', logo: azureLogo, items: ['Azure Marketplace transactable offers', 'Partner Center co-sell', 'Microsoft field alignment and MACC'] },
  { name: 'Google Cloud', logo: gcpLogo, items: ['Google Cloud Marketplace listings', 'Partner Advantage co-sell', 'Google Cloud field engagement'] },
];

const compare = [
  'Executes GTM alongside your team, every week',
  'Activates hyperscaler field relationships',
  'Identifies and advances real co-sell opportunities',
  'Produces field-validated deal evidence',
  'Runs field enablement sessions with cloud teams',
  'Delivers a board-ready, attributable pipeline report',
  'Aligns MDF, co-marketing and cloud GTM into measurable ROI',
];

const solutionIcons: Record<string, string> = {
  'aws-marketplace-listing': 'M4 5h16v4H4zM4 11h10v8H4zM16 11h4v8h-4z',
  storefront: 'M4 9l1.5-5h13L20 9M4 9h16v11H4zM9 20v-6h6v6',
  'co-sell-execution': 'M7 12a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm10 0a4 4 0 1 1 0-8 4 4 0 0 1 0 8ZM2 20c0-3 2.5-5 5-5s5 2 5 5m0 0c0-3 2.5-5 5-5s5 2 5 5',
  'alliance-leadership': 'M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9z',
  'co-marketing': 'M3 11v2l13 5V6L3 11Zm13-5 5-2v16l-5-2M6 14l1.5 5h3L9 15',
  'box-funding-readiness': 'M12 3v18M17 7H9.5a3 3 0 0 0 0 6h5a3 3 0 0 1 0 6H6',
  'genai-competency-readiness': 'M12 2l2 5 5 2-5 2-2 5-2-5-5-2 5-2zM18 15l1 2.5 2.5 1-2.5 1L18 22l-1-2.5-2.5-1 2.5-1z',
  'partner-revenue-measurement': 'M4 20V10M10 20V4M16 20v-7M22 20H2',
  'partner-central-migration': 'M4 7h13l-3-3M20 17H7l3 3',
};

const faqs = [
  { q: 'What is SaaSNova?', a: 'SaaSNova helps SaaS ISVs and channel partners turn cloud marketplaces (AWS, Microsoft Azure and Google Cloud) into a predictable revenue channel. We work alongside software companies to execute their Marketplace GTM, strengthen co-sell with hyperscaler field teams, and create measurable pipeline and revenue through the cloud marketplace ecosystem.' },
  { q: 'What does operator-led GTM execution mean?', a: 'Our operators do the work. We build and optimize listings, run co-sell in ACE and Partner Center, build relationships with cloud field teams, deliver enablement sessions, package private offers and report attributable pipeline. You do not get a playbook to run yourself.' },
  { q: 'Which cloud marketplaces do you work with?', a: 'AWS Marketplace, Microsoft Azure Marketplace and Google Cloud Marketplace. Ignite can start on any one of them. SuperNova and NovaX run co-sell across AWS, Microsoft and Google Cloud.' },
  { q: 'Which program is right for us?', a: 'Ignite (1 month) is for Pre-Series A to Series A ISVs that need a listing or have one with little traction. SuperNova (4 months) is for Series A to Series B ISVs entering the US market. NovaX (6 months) is for Series A to Series C ISVs scaling repeatable multi-cloud revenue. Use the program finder above, or book a 30-minute session and Jen will tell you which fits.' },
  { q: 'How much does a program cost?', a: 'Every SaaSNova program is custom. On a 30-minute scoping call we look at your listing, your clouds and your targets, then send a proposal with the scope, timeline and investment.' },
  { q: 'How do we buy?', a: 'After the scoping call you receive a proposal. You can contract with SaaSNova directly, or procure through your cloud marketplace if your procurement team prefers. We walk you through either path.' },
  { q: 'How fast will we see results?', a: 'Ignite runs for one month. GuardDog launched its first SaaS listing on AWS Marketplace in one week with SaaSNova, after nearly two years of trying alone. Simplesense unlocked more than $40K in credits and funding through Ignite.' },
];
const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const jsonLd = [
  { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: 'SaaSNova', publisher: { '@id': `${site.url}/#organization` } },
  faqLd,
];
---
<Base
  title="SaaSNova | The first operator-led GTM execution engine for cloud marketplaces"
  description="SaaSNova helps SaaS ISVs and channel partners turn AWS, Microsoft Azure and Google Cloud marketplaces into a predictable revenue channel. Flagship programs: Ignite, SuperNova and NovaX."
  jsonLd={jsonLd}
  brandSuffix={false}
>
  <!-- ═══ HERO ═══ -->
  <section class="hero bg-glow">
    <div class="hero-grid" aria-hidden="true"></div>
    <svg class="star" viewBox="0 0 200 200" aria-hidden="true"><defs><linearGradient id="sg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#008BF8"/><stop offset="1" stop-color="#FA0F9C"/></linearGradient></defs><path d="M100 0l12 88 88 12-88 12-12 88-12-88L0 100l88-12z" fill="url(#sg)"/></svg>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="kicker">GTM execution across AWS, Microsoft Azure and Google Cloud</p>
        <h1 class="hero-h"><span class="l">The first</span> <span class="l grad">operator-led GTM</span> <span class="l grad">execution engine.</span></h1>
        <p class="lead hero-lead">
          SaaSNova helps SaaS ISVs and channel partners turn cloud marketplaces into a <strong>predictable revenue channel</strong>.
          We work alongside your team to execute your Marketplace GTM, strengthen co-sell with hyperscaler field teams, and create
          measurable pipeline and revenue.
        </p>
        <ul class="clouds" role="list" aria-label="Hyperscalers we execute on">
          <li><Image src={awsLogo} alt="" height={40} /><span>AWS</span></li>
          <li><Image src={azureLogo} alt="" height={40} /><span>Microsoft Azure</span></li>
          <li><Image src={gcpLogo} alt="" height={40} /><span>Google Cloud</span></li>
        </ul>
        <div class="btn-row">
          <a class="btn btn-lg" href={primaryCta.href} target="_blank" rel="noopener" data-track="cta_strategy_hero">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            {primaryCta.label}
          </a>
          <a class="btn btn-secondary btn-lg" href="#programs">Explore programs</a>
        </div>
      </div>

      <div class="hero-media">
        <div class="video-frame">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${heroVideo}?rel=0&modestbranding=1&playsinline=1`}
            title="Why SaaSNova exists: execution-led GTM for ISVs, with founder Jen Dawson"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            loading="eager"
          ></iframe>
        </div>
        <div class="float f1"><Image src={advancedBadge} alt="" width={44} height={44} /><span><strong>AWS Advanced Tier</strong>Services Partner</span></div>
        <div class="float f2"><span class="big num">100+</span><span>ISVs activated<br />across 3 clouds</span></div>
        <div class="float f3"><span class="dot" aria-hidden="true"></span><span><strong>Official launch partner</strong>AWS Marketplace Storefront</span></div>
      </div>
    </div>
  </section>

  <!-- ═══ TRUST ═══ -->
  <section class="trust" aria-labelledby="trust-h">
    <div class="container">
      <div class="badges">
        <div class="badge-imgs">
          <Image src={advancedBadge} alt="AWS Partner, Advanced Tier Services" width={92} height={92} />
          <Image src={aiBadge} alt="AWS Partner, AI Services Competency" width={92} height={92} />
        </div>
        <ul role="list" class="creds">
          <li><strong>AWS Advanced Tier</strong><span>Services Partner</span></li>
          <li><strong>AWS AI Services</strong><span>Competency Partner</span></li>
          <li><strong>Storefront launch partner</strong><span>AWS Marketplace</span></li>
          <li><strong>Women-owned</strong><span>Founder-led business</span></li>
        </ul>
      </div>
      <p id="trust-h" class="trust-title">Trusted by <strong>100+ SaaS ISVs</strong> scaling with hyperscalers</p>
      <LogoMarquee logos={customerLogos} label="Customers" duration={55} />
    </div>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="section bg-grid" aria-labelledby="love-h" id="customers">
    <div class="container">
      <div class="section-head split-head">
        <div>
          <p class="kicker pink">What ISV leaders and field teams say</p>
          <h2 id="love-h">Don’t take our word for it. <span class="grad">Take theirs.</span></h2>
        </div>
        <p>Founders, CEOs, alliance leaders and AWS partner teams on what changed once SaaSNova started executing.</p>
      </div>
      <TestimonialWall />
      <div class="g2 reveal">
        <div class="stars" aria-hidden="true">★★★★★</div>
        <p><strong>Worked with SaaSNova?</strong> Share your experience on G2. It helps other ISVs choose with confidence.</p>
        <a class="btn btn-secondary btn-sm" href={g2ReviewUrl} target="_blank" rel="noopener" data-track="g2_review">Review us on G2</a>
      </div>
    </div>
  </section>

  <!-- ═══ PROBLEM → TRANSFORMATION ═══ -->
  <section class="section bg-mist" aria-labelledby="gap-h">
    <div class="container split problem">
      <div class="reveal">
        <p class="kicker orange">The resource gap</p>
        <h2 id="gap-h">So your marketplace listing is live. <span class="grad">But no pipeline means no revenue.</span></h2>
        <p class="lead">
          Most ISVs get listed and then stall. Cloud field teams don’t engage, co-sell submissions go unanswered, and MDF sits
          unclaimed because nobody inside owns the motion. We step in as your dedicated cloud GTM operators and fill that gap.
        </p>
        <a class="link-arrow" href="#programs">See how we fix it</a>
      </div>
      <div class="transform reveal" aria-label="Pipeline transformation">
        <div class="state before">
          <p class="state-h">Before</p>
          <ul role="list">
            <li>Listing live, zero co-sell</li>
            <li>No field relationships</li>
            <li>MDF sitting unclaimed</li>
          </ul>
          <p class="status">Status: Dormant</p>
        </div>
        <div class="arrow" aria-hidden="true"><span class="arrow-ic">→</span><span class="arrow-l">SaaSNova<br />execution</span></div>
        <div class="state after">
          <p class="state-h">After</p>
          <ul role="list">
            <li>Active pipeline</li>
            <li>Field relationships active</li>
            <li>MDF unlocked and used</li>
          </ul>
          <p class="status">Status: Operational</p>
        </div>
        <dl class="stats">
          <div><dt><span class="num" data-count="2000" data-suffix="+">2K+</span></dt><dd>PSQLs · Arctic Wolf</dd></div>
          <div><dt><span class="num" data-count="300" data-prefix="$" data-suffix="K">$300K</span></dt><dd>MDF secured · Dataminr</dd></div>
          <div><dt><span class="num" data-count="9" data-suffix="X">9X</span></dt><dd>ROI · Arctic Wolf</dd></div>
          <div><dt><span class="num" data-count="100" data-suffix="+">100+</span></dt><dd>ISVs activated</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ═══ HOW WE EXECUTE ═══ -->
  <section class="section" aria-labelledby="exec-h">
    <div class="container">
      <div class="section-head center">
        <p class="kicker">What execution means at SaaSNova</p>
        <h2 id="exec-h">We don’t hand you a playbook. <span class="grad">We execute it.</span></h2>
        <p>Every engagement is shaped to your GTM stage, your cloud mix and your revenue goals. Then our operators go and do the work.</p>
      </div>
      <ol class="moves" role="list">
        {moves.map((m, i) => (
          <li class="move reveal" style={`--c:${m.color};transition-delay:${i * 80}ms`}>
            <span class="move-n" aria-hidden="true">0{i + 1}</span>
            <p class="verb">{m.verb}</p>
            <h3>{m.title}</h3>
            <p>{m.body}</p>
            <p class="outcome"><span aria-hidden="true">✓</span> {m.outcome}</p>
          </li>
        ))}
      </ol>

      <div class="cloud-grid">
        {clouds.map((c) => (
          <div class="cloud reveal">
            <div class="cloud-top"><Image src={c.logo} alt="" height={56} /><h3>{c.name}</h3></div>
            <ul role="list" class="checks">{c.items.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FLAGSHIP PROGRAMS ═══ -->
  <section class="section on-ink" id="programs" aria-labelledby="prog-h">
    <div class="container">
      <div class="section-head center">
        <p class="kicker pink">Flagship programs</p>
        <h2 id="prog-h">Pick your stage. <span class="grad">We customize the execution.</span></h2>
        <p>Three programs, from first listing to global multi-cloud scale. Each one is scoped to your clouds, your listing and your revenue targets.</p>
      </div>
      <ProgramCards />

      <div class="finder-wrap" id="program-finder">
        <div class="finder-copy reveal">
          <p class="kicker">60-second program finder</p>
          <h3>Not sure which program fits?</h3>
          <p>Answer four questions and we’ll point you to the right starting program. Then confirm it with Jen on a 30-minute call.</p>
          <ul role="list" class="checks">
            <li>No forms, no email required</li>
            <li>Based on how we scope real engagements</li>
          </ul>
        </div>
        <ProgramFinder />
      </div>
    </div>
  </section>

  <!-- ═══ MORE SOLUTIONS ═══ -->
  <section class="section" aria-labelledby="sol-h">
    <div class="container">
      <div class="section-head split-head">
        <div>
          <p class="kicker">Execution solutions</p>
          <h2 id="sol-h">Need one motion, not a full program?</h2>
        </div>
        <p>Embedded execution for ISVs that already have a motion and need operators to close a specific gap, month over month.</p>
      </div>
      <ul role="list" class="sol-grid">
        {services.map((s) => (
          <li>
            <a class="sol reveal" href={offeringPath(s)}>
              <span class="sol-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={solutionIcons[s.slug] ?? 'M4 12h16'} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
              <span class="sol-t">{s.short}{s.noCost && <span class="tag tag-ok">No cost</span>}</span>
              <span class="sol-d">{s.summary.split('. ')[0].replace(/\.$/, '')}.</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="center-link"><a class="link-arrow" href="/solutions">Compare every solution</a></p>
    </div>
  </section>

  <!-- ═══ STOREFRONT ═══ -->
  <section class="section storefront bg-mist" aria-labelledby="sf-h">
    <div class="container split even sf">
      <div class="reveal">
        <p class="kicker pink">Official launch partner · AWS Marketplace Storefront</p>
        <h2 id="sf-h">We launched with AWS Marketplace Storefront. <span class="grad">Now we build storefronts for ISVs.</span></h2>
        <p class="lead">
          SaaSNova was selected as an official launch partner for AWS Marketplace Storefront. We deploy and operate branded
          storefronts, including the Women-Owned Cloud Innovation Storefront with AWS and The Female Quotient.
        </p>
        <div class="btn-row">
          <a class="btn btn-secondary" href="/storefront">Explore our storefront work</a>
          <a class="link-arrow" href={offeringPath(services.find((s) => s.slug === 'storefront')!)}>Storefront as a Service</a>
        </div>
      </div>
      <figure class="sf-img reveal">
        <Image src={storefrontBanner} alt="The Women-Owned Cloud Innovation Storefront on AWS Marketplace, deployed by SaaSNova" widths={[480, 800, 1100]} sizes="(min-width: 60rem) 45vw, 100vw" />
      </figure>
    </div>
    <div class="sf-logos">
      <p class="container sf-cap">Companies on AWS Marketplace Storefront with SaaSNova</p>
      <LogoMarquee logos={storefrontLogos.slice(0, 16)} label="Storefront companies, row one" duration={70} height={30} />
      <LogoMarquee logos={storefrontLogos.slice(16)} label="Storefront companies, row two" duration={70} height={30} reverse />
    </div>
  </section>

  <!-- ═══ CASE STUDIES ═══ -->
  <section class="section" aria-labelledby="cs-h">
    <div class="container">
      <div class="section-head split-head">
        <div>
          <p class="kicker orange">Case studies</p>
          <h2 id="cs-h">Results that show up in <span class="grad">the pipeline report.</span></h2>
        </div>
        <p>How our operating model took two security ISVs from unmanaged to field priority inside AWS.</p>
      </div>
      <div class="cases">
        {trackRecord.map((t, i) => (
          <a class="case reveal" href={`/case-studies/${t.slug}`} style={`transition-delay:${i * 90}ms`}>
            <div class="case-top">
              <Image src={t.logo} alt={`${t.company} logo`} height={34} />
              <span class="tag tag-pink">Case study</span>
            </div>
            <h3>{t.title}</h3>
            <dl class="case-stats">
              {t.results.slice(0, 3).map((r) => (<div><dt class="num">{r.n}</dt><dd>{r.l}</dd></div>))}
            </dl>
            <span class="link-arrow">Read the {t.company} story</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ COMPARISON ═══ -->
  <section class="section bg-mist" aria-labelledby="cmp-h">
    <div class="container">
      <div class="section-head center">
        <p class="kicker">Why SaaSNova</p>
        <h2 id="cmp-h">Not advice. Not theory. <span class="grad">Execution.</span></h2>
        <p>Playbooks tell you what to do. Software gives you a dashboard. We embed as your cloud GTM operators and do the work.</p>
      </div>
      <div class="cmp-wrap reveal">
        <table class="cmp">
          <caption class="visually-hidden">How SaaSNova compares with playbooks, fractional hires and software-only platforms</caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col" class="us">SaaSNova</th>
              <th scope="col">Playbooks and fractional hires</th>
              <th scope="col">Software-only platforms</th>
            </tr>
          </thead>
          <tbody>
            {compare.map((c, i) => (
              <tr>
                <th scope="row">{c}</th>
                <td class="us"><span class="yes" aria-label="Yes">✓</span></td>
                <td>{i === 0 || i === 4 ? <span class="part">Partly</span> : <span class="no" aria-label="No">—</span>}</td>
                <td>{i === 5 ? <span class="part">Dashboards only</span> : <span class="no" aria-label="No">—</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ═══ FOUNDER ═══ -->
  <section class="section founder-sec" aria-labelledby="founder-h">
    <div class="container split founder">
      <div class="photo reveal">
        <Image src={jenStage} alt="Jen Dawson, founder and CEO of SaaSNova, speaking on stage" widths={[480, 800, 1100]} sizes="(min-width: 60rem) 42vw, 100vw" />
        <div class="photo-tag"><Image src={jenPhoto} alt="" width={52} height={52} /><span><strong>Jen Dawson</strong>Founder and CEO</span></div>
      </div>
      <div class="reveal">
        <p class="kicker">Founder-led, on purpose</p>
        <h2 id="founder-h">Built by an operator who ran GTM <span class="grad">inside AWS.</span></h2>
        <p class="lead">
          Jen Dawson, SaaSNova’s founder and CEO, is a former Global GTM Lead at AWS with more than 25 years in cloud go-to-market.
          She has activated more than 100 ISVs across AWS, Microsoft Azure and Google Cloud.
        </p>
        <blockquote class="jen-q">
          “We built SaaSNova to close the execution gap for SaaS companies. Our customers need the Marketplace, partner, and co-sell work done.”
        </blockquote>
        <dl class="mini-stats">
          <div><dt class="num">25+</dt><dd>years in cloud GTM</dd></div>
          <div><dt class="num">100+</dt><dd>ISVs activated</dd></div>
          <div><dt class="num">3</dt><dd>hyperscalers</dd></div>
        </dl>
        <div class="btn-row"><a class="btn btn-secondary" href="/about">Meet the team</a></div>
      </div>
    </div>
  </section>

  <!-- ═══ SHOW + EVENTS ═══ -->
  <section class="section on-ink" aria-labelledby="show-h">
    <div class="container split even show">
      <div class="reveal">
        <p class="kicker pink">The Jen GTM Show</p>
        <h2 id="show-h">Why execution produces pipeline <span class="grad">that advice never will.</span></h2>
        <p class="lead">Jen on the exact execution gap that keeps ISVs from generating co-sell pipeline on AWS, Azure and Google Cloud. No frameworks. No theory. What actually works.</p>
        <div class="btn-row"><a class="btn btn-light" href="/show">Watch all episodes</a></div>
      </div>
      <div class="reveal"><YouTube id="EN63uxhcn08" title="Cloud GTM execution: why most ISVs stall on Marketplace" /></div>
    </div>
    <div class="container ground">
