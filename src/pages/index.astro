---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TestimonialWall from '../components/TestimonialWall.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import ProgramCards from '../components/ProgramCards.astro';
import ProgramFinder from '../components/ProgramFinder.astro';
import CinemaVideo from '../components/CinemaVideo.astro';
import PipelineChart from '../components/PipelineChart.astro';
import advancedBadge from '../assets/images/SaaSNova-AWS-Advanced-Tier-badge.png';
import aiBadge from '../assets/images/SaaSNova-AWS-AI-Service-Competency-partner-badge.png';
import awsLogo from '../assets/images/aws-logo.png';
import azureLogo from '../assets/images/azure-logo.png';
import gcpLogo from '../assets/images/gcp-logo.png';
import storefrontBanner from '../assets/images/fq-storefront.jpg';
import { customerLogos, storefrontLogos } from '../data/logos';
import { categories, offerings, offeringPath } from '../data/offerings';
import { trackRecord } from '../data/track-record';
import { primaryCta, site } from '../data/site';
import { g2ReviewUrl } from '../data/testimonials';

const heroVideo = 'x75hrIBKPj8';
const insights = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

// Solutions grouped by category (programs are shown separately above).
const solutionGroups = categories
  .filter((c) => c.id !== 'programs')
  .map((c) => ({ ...c, items: offerings.filter((o) => o.category === c.id) }));

const compare = [
  'Executes GTM alongside your team, every week',
  'Activates hyperscaler field relationships',
  'Advances real co-sell opportunities to close',
  'Runs field enablement with cloud sellers',
  'Delivers a board-ready, attributable pipeline report',
];

const steps = [
  { t: '30-min strategy session', d: 'We review your listing, clouds and co-sell activity.' },
  { t: 'Custom program proposal', d: 'Scope, owners, timeline and investment.' },
  { t: 'Operators execute', d: 'Weekly cadence, monthly KPI reviews.' },
];

const faqs = [
  { q: 'What is SaaSNova?', a: 'SaaSNova helps SaaS ISVs and channel partners turn cloud marketplaces (AWS, Microsoft Azure and Google Cloud) into a predictable revenue channel. We work alongside software companies to execute their Marketplace GTM, strengthen co-sell with hyperscaler field teams, and create measurable pipeline and revenue.' },
  { q: 'What does operator-led GTM execution mean?', a: 'Our operators do the work: listings, co-sell in ACE and Partner Center, field relationships, enablement sessions, private offers and attributable pipeline reporting. You do not get a playbook to run yourself.' },
  { q: 'Which cloud marketplaces do you work with?', a: 'AWS Marketplace, Microsoft Azure Marketplace and Google Cloud Marketplace.' },
  { q: 'Which program is right for us?', a: 'Ignite (1 month) for Pre-Series A to Series A ISVs that need a listing or have one with little traction. SuperNova (4 months) for Series A to B ISVs entering the US. NovaX (6 months) for Series A to C ISVs scaling multi-cloud revenue.' },
  { q: 'How much does a program cost?', a: 'Every program is custom. We scope yours on a 30-minute call, then send a proposal with scope, timeline and investment.' },
  { q: 'How do we buy?', a: 'Contract with SaaSNova directly, or procure through your cloud marketplace if your procurement team prefers.' },
];
const jsonLd = [
  { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: 'SaaSNova', publisher: { '@id': `${site.url}/#organization` } },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base
  title="SaaSNova | The first operator-led GTM execution engine for cloud marketplaces"
  description="SaaSNova helps SaaS ISVs and channel partners turn AWS, Microsoft Azure and Google Cloud marketplaces into a predictable revenue channel. Programs: Ignite, SuperNova and NovaX."
  jsonLd={jsonLd}
  brandSuffix={false}
>
  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-top">
      <h1 class="hero-h"><span class="l">The first operator-led</span> <span class="l grad">GTM execution engine.</span></h1>
      <p class="hero-lead">We turn your AWS, Microsoft Azure and Google Cloud marketplace listing into a predictable revenue channel. Our operators do the work.</p>
      <div class="btn-row hero-ctas">
        <a class="btn btn-lg" href={primaryCta.href} target="_blank" rel="noopener" data-track="cta_strategy_hero">{primaryCta.label}</a>
        <a class="btn btn-secondary btn-lg" href="#programs">See programs</a>
      </div>
    </div>
    <div class="container hero-video">
      <CinemaVideo id={heroVideo} title="Why SaaSNova exists: execution-led GTM for ISVs" />
    </div>
    <div class="container trust">
      <div class="trust-row">
        <p class="on">Executing on</p>
        <ul class="clouds" role="list" aria-label="Hyperscalers">
          <li><Image src={awsLogo} alt="AWS" height={56} /></li>
          <li><Image src={azureLogo} alt="Microsoft Azure" height={56} /><span>Microsoft Azure</span></li>
          <li><Image src={gcpLogo} alt="Google Cloud" height={56} /><span>Google Cloud</span></li>
        </ul>
        <span class="sep" aria-hidden="true"></span>
        <div class="badges">
          <Image src={advancedBadge} alt="AWS Partner, Advanced Tier Services" width={64} height={64} />
          <Image src={aiBadge} alt="AWS Partner, AI Services Competency" width={64} height={64} />
          <p><strong>Official launch partner</strong><br />AWS Marketplace Storefront</p>
        </div>
      </div>
      <p class="trust-title">Trusted by 100+ SaaS ISVs scaling with hyperscalers</p>
      <LogoMarquee logos={customerLogos} label="Customers" duration={55} />
    </div>
  </section>

  <!-- ═══ THE STORY: pipeline chart ═══ -->
  <section class="section on-ink story" aria-labelledby="story-h">
    <div class="container">
      <div class="story-head">
        <h2 id="story-h">Listed isn’t launched.</h2>
        <p>Most marketplace listings flatline. Our operators run the four motions that move the line: Activate, Drive, Convert, Prove.</p>
      </div>
      <PipelineChart />
      <dl class="results">
        <div><dt class="num">2K+</dt><dd>PSQLs generated for Arctic Wolf</dd></div>
        <div><dt class="num">$300K</dt><dd>MDF secured for Dataminr</dd></div>
        <div><dt class="num">9X</dt><dd>ROI validated by AWS</dd></div>
        <div><dt class="num">100+</dt><dd>ISVs activated on 3 clouds</dd></div>
      </dl>
    </div>
  </section>

  <!-- ═══ PROGRAMS ═══ -->
  <section class="section bg-mist" id="programs" aria-labelledby="prog-h">
    <div class="container">
      <div class="section-head center">
        <h2 id="prog-h">Pick your stage.<br /><span class="grad">We customize the execution.</span></h2>
        <p>Three programs, from first listing to global multi-cloud scale.</p>
      </div>
      <ProgramCards />
      <div class="finder-wrap" id="program-finder">
        <div class="finder-copy">
          <h3>Not sure which program fits?</h3>
          <p>Four questions. One recommendation. No email required.</p>
        </div>
        <ProgramFinder />
      </div>
    </div>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="section bg-grid" aria-labelledby="love-h" id="customers">
    <div class="container">
      <div class="section-head center">
        <h2 id="love-h">Results, in<br /><span class="grad">our customers’ words.</span></h2>
      </div>
      <TestimonialWall />
      <div class="g2">
        <div class="stars" aria-hidden="true">★★★★★</div>
        <p><strong>Worked with SaaSNova?</strong> Share your experience on G2.</p>
        <a class="btn btn-secondary btn-sm" href={g2ReviewUrl} target="_blank" rel="noopener" data-track="g2_review">Review us on G2</a>
      </div>
    </div>
  </section>

  <!-- ═══ PROOF BENTO: case studies + storefront ═══ -->
  <section class="section bg-mist" aria-labelledby="proof-h">
    <div class="container">
      <div class="section-head center">
        <h2 id="proof-h">Numbers that show up<br /><span class="grad">in the pipeline report.</span></h2>
      </div>
      <div class="bento">
        {trackRecord.map((t) => (
          <a class="tile case" href={`/case-studies/${t.slug}`}>
            <div class="case-top"><Image src={t.logo} alt={`${t.company} logo`} height={32} /><span class="tag tag-pink">Case study</span></div>
            <p class="big num">{t.results.find((r) => /^[$0-9]/.test(r.n))!.n}</p>
            <p class="big-l">{t.results.find((r) => /^[$0-9]/.test(r.n))!.l}</p>
            <ul role="list" class="mini">{t.results.filter((r) => r !== t.results.find((x) => /^[$0-9]/.test(x.n))).slice(0, 2).map((r) => <li><strong>{r.n}</strong> {r.l}</li>)}</ul>
            <span class="go">Read the story <span aria-hidden="true">→</span></span>
          </a>
        ))}
        <a class="tile sf" href="/storefront">
          <div class="sf-copy">
            <span class="tag tag-pink">Official launch partner</span>
            <p class="sf-t">AWS Marketplace Storefront</p>
            <p class="sf-d">We launched with AWS and now deploy branded storefronts for ISVs.</p>
            <span class="go">See storefront work <span aria-hidden="true">→</span></span>
          </div>
          <Image class="sf-img" src={storefrontBanner} alt="The Women-Owned Cloud Innovation Storefront on AWS Marketplace, deployed by SaaSNova" widths={[480, 800]} sizes="(min-width: 60rem) 40vw, 100vw" />
        </a>
      </div>
      <div class="sf-logos">
        <LogoMarquee logos={storefrontLogos.slice(0, 16)} label="Storefront companies, row one" duration={70} height={28} />
        <LogoMarquee logos={storefrontLogos.slice(16)} label="Storefront companies, row two" duration={70} height={28} reverse />
      </div>
    </div>
  </section>

  <!-- ═══ SOLUTIONS BY CATEGORY ═══ -->
  <section class="section" aria-labelledby="sol-h">
    <div class="container">
      <div class="section-head center">
        <h2 id="sol-h">Need one motion,<br /><span class="grad">not a full program?</span></h2>
      </div>
      <div class="cats">
        {solutionGroups.map((g) => (
          <div class="cat">
            <h3>{g.title}</h3>
            <ul role="list">
              {g.items.map((o) => <li><a href={offeringPath(o)}>{o.short}</a>{o.noCost && <span class="free">No cost</span>}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ COMPARISON ═══ -->
  <section class="section bg-mist" aria-labelledby="cmp-h">
    <div class="container">
      <div class="section-head center">
        <h2 id="cmp-h">Not advice. Not theory.<br /><span class="grad">Execution.</span></h2>
      </div>
      <div class="cmp-wrap">
        <table class="cmp">
          <caption class="visually-hidden">SaaSNova compared with playbooks, fractional hires and software-only platforms</caption>
          <thead><tr><th scope="col"><span class="visually-hidden">Capability</span></th><th scope="col" class="us">SaaSNova</th><th scope="col">Playbooks and fractional hires</th><th scope="col">Software-only platforms</th></tr></thead>
          <tbody>
            {compare.map((c, i) => (
              <tr>
                <th scope="row">{c}</th>
                <td class="us"><span class="yes" aria-label="Yes">✓</span></td>
                <td>{i === 0 || i === 3 ? <span class="part">Partly</span> : <span class="no" aria-label="No">—</span>}</td>
                <td>{i === 4 ? <span class="part">Dashboards only</span> : <span class="no" aria-label="No">—</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ═══ INSIGHTS ═══ -->
  {insights.length > 0 && (
    <section class="section" aria-labelledby="ins-h">
      <div class="container">
        <div class="section-head center">
            <h2 id="ins-h">Practitioner-grade GTM intelligence.</h2>
        </div>
        <ul role="list" class="posts">
          {insights.map((e) => (
            <li>
              <a href={`/insights/${e.id}`} class="post">
                {e.data.heroImage && <img src={e.data.heroImage} alt="" width="800" height="450" loading="lazy" decoding="async" />}
                <span class="post-body">
                  {e.data.tags[0] && <span class="tag">{e.data.tags[0]}</span>}
                  <span class="post-t">{e.data.title}</span>
                  <span class="post-m">{fmt(e.data.date)}{e.data.readingTime && ` · ${e.data.readingTime} min read`}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ═══ FAQ ═══ -->
  <section class="section bg-mist" aria-labelledby="faq-h">
    <div class="container faq-split">
      <div>
        <h2 id="faq-h">Questions ISVs ask<br /><span class="grad">before the call.</span></h2>
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ START (final CTA) ═══ -->
  <section class="start on-ink" aria-labelledby="start-h">
    <div class="container">
      <h2 id="start-h">Ready to turn your listing<br /><span class="grad">into pipeline?</span></h2>
      <ol role="list" class="steps">
        {steps.map((s, i) => (
          <li><span class="n">{i + 1}</span><span class="st">{s.t}</span><span class="sd">{s.d}</span></li>
        ))}
      </ol>
      <a class="btn btn-lg" href={primaryCta.href} target="_blank" rel="noopener" data-track="cta_strategy_final">{primaryCta.label}</a>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { position: relative; isolation: isolate; overflow: hidden; margin-top: -5.25rem; padding: calc(5.25rem + clamp(2.5rem, 1rem + 4vw, 4.5rem)) 0 clamp(3rem, 2rem + 3vw, 5rem); background: #fff; }
  .hero-glow { position: absolute; inset: 0 0 auto; height: 80%; z-index: -1; pointer-events: none;
    background: radial-gradient(40% 50% at 20% 10%, rgba(0, 139, 248, 0.16), transparent 70%), radial-gradient(40% 50% at 85% 20%, rgba(250, 15, 156, 0.13), transparent 70%), radial-gradient(30% 40% at 55% 60%, rgba(241, 153, 83, 0.10), transparent 70%); }
  .hero-top { text-align: center; display: grid; justify-items: center; }
  .hero-h { font-size: clamp(2.6rem, 0.9rem + 6.2vw, 6.25rem); line-height: 0.98; letter-spacing: -0.055em; font-weight: 800; max-width: 16ch; }
  .hero-h .l { display: block; }
  .hero-h .grad { font-weight: 850; padding-bottom: 0.08em; }
  .hero-lead { margin-top: 1.5rem; font-size: clamp(1.15rem, 1rem + 0.55vw, 1.45rem); line-height: 1.5; color: var(--muted); max-width: 40rem; }
  .hero-ctas { justify-content: center; margin-top: 2.25rem; }
  .hero-video { margin-top: clamp(2.75rem, 2rem + 3vw, 4.5rem); max-width: 72rem; }

  .trust { margin-top: clamp(3rem, 2rem + 3vw, 4.5rem); }
  .trust-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1.25rem 2rem; }
  .trust-row .on { font-weight: 650; color: var(--muted); }
  .clouds { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.75rem 1.75rem; }
  .clouds li { display: flex; align-items: center; gap: 0.5rem; white-space: nowrap; font-weight: 700; color: var(--ink); font-size: 1.05rem; letter-spacing: -0.01em; }
  .clouds :global(img) { height: 28px; width: auto; }
  .sep { width: 1px; height: 2.5rem; background: var(--line-strong); }
  .badges { display: flex; align-items: center; gap: 0.9rem; }
  .badges :global(img) { width: 64px; height: 64px; object-fit: contain; }
  .badges p { font-size: 0.9rem; color: var(--muted); line-height: 1.35; margin-left: 0.25rem; }
  .badges strong { color: var(--ink); }
  @media (max-width: 47.99rem) { .sep { display: none; } .trust-row .on { width: 100%; text-align: center; } }
  .trust-title { text-align: center; color: var(--muted); font-weight: 600; margin: 2.75rem 0 1.5rem; }

  /* Story */
  .story-head { display: grid; gap: 1rem; margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem); }
  @media (min-width: 60rem) { .story-head { grid-template-columns: 1fr 1fr; align-items: end; gap: 4rem; } }
  .story-head h2 { font-size: clamp(2.6rem, 1.5rem + 4vw, 5rem); letter-spacing: -0.055em; line-height: 0.98; }
  .story-head p { font-size: 1.2rem; line-height: 1.55; max-width: 32rem; }
  .results { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.5rem; margin-top: clamp(3rem, 2rem + 3vw, 5rem); padding-top: 2.5rem; border-top: 1px solid var(--on-ink-line); }
  @media (min-width: 48rem) { .results { grid-template-columns: repeat(4, 1fr); } }
  .results dt { font-size: clamp(2.6rem, 1.8rem + 2.6vw, 4.25rem); font-weight: 800; letter-spacing: -0.055em; line-height: 1; color: #fff; }
  .results dd { margin: 0.6rem 0 0; color: var(--on-ink-muted); font-size: 0.975rem; }

  /* Finder */
  .finder-wrap { display: grid; gap: 2rem; margin-top: clamp(3rem, 2rem + 3vw, 5rem); align-items: center; }
  @media (min-width: 60rem) { .finder-wrap { grid-template-columns: 1fr 1.3fr; gap: 4rem; } }
  .finder-copy h3 { font-size: clamp(1.9rem, 1.4rem + 1.4vw, 2.6rem); font-weight: 800; letter-spacing: -0.04em; margin-bottom: 0.75rem; }
  .finder-copy p { font-size: 1.15rem; color: var(--muted); }

  .g2 { margin-top: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; padding: 1rem 1.25rem; border-radius: var(--r-md); background: #fff; border: 1px solid var(--line); }
  .g2 .stars { color: var(--orange); letter-spacing: 0.15em; font-size: 1.1rem; }
  .g2 p { flex: 1; min-width: 14rem; color: var(--muted); }
  .g2 strong { color: var(--ink); }

  /* Bento */
  .bento { display: grid; gap: 1.25rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 60rem) { .bento { grid-template-columns: 1fr 1fr 1.4fr; } }
  .tile { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; padding: 1.75rem; border-radius: var(--r-xl); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow); text-decoration: none; color: inherit; transition: transform 220ms var(--ease), box-shadow 220ms var(--ease); overflow: hidden; }
  .tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .case-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .case-top :global(img) { height: 32px; width: auto; max-width: 60%; }
  .big { font-size: clamp(3rem, 2.4rem + 2vw, 4.25rem); font-weight: 900; letter-spacing: -0.05em; line-height: 1; background: var(--nova); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .big-l { font-weight: 650; color: var(--ink); font-size: 1.05rem; }
  .mini { display: grid; gap: 0.35rem; margin-top: 0.75rem; padding-top: 0.9rem; border-top: 1px dashed var(--line); font-size: 0.9rem; color: var(--muted); }
  .mini strong { color: var(--ink); }
  .go { margin-top: auto; padding-top: 1rem; font-weight: 700; color: var(--blue-ink); }
  .sf { padding: 0; background: var(--night); border: 0; }
  .sf-copy { padding: 1.75rem 1.75rem 1.25rem; display: grid; gap: 0.5rem; }
  .sf-copy .tag { justify-self: start; }
  .sf-t { font-size: 1.6rem; font-weight: 850; letter-spacing: -0.03em; color: #fff; line-height: 1.15; }
  .sf-d { color: var(--on-ink-muted); }
  .sf .go { color: #8fcbff; padding-top: 0.25rem; }
  .sf :global(.sf-img) { width: calc(100% - 2.5rem); margin: auto 1.25rem 1.25rem; height: auto; border-radius: var(--r-md); }
  .sf-logos { margin-top: 2.5rem; display: grid; gap: 1.25rem; }

  /* Solution categories */
  .cats { display: grid; gap: 1.25rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 48rem) { .cats { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 72rem) { .cats { grid-template-columns: repeat(4, 1fr); } }
  .cats { gap: 2.5rem 3rem; }
  .cat { padding-top: 1.25rem; border-top: 3px solid; border-image: var(--nova) 1; }
  .cat h3 { font-size: 1.25rem; letter-spacing: -0.025em; margin-bottom: 1rem; }
  .cat ul { display: grid; gap: 0.2rem; }
  .cat li { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
  .cat a { padding: 0.35rem 0; text-decoration: none; color: var(--ink); font-weight: 550; font-size: 1.05rem; background-image: linear-gradient(currentColor, currentColor); background-size: 0 1px; background-repeat: no-repeat; background-position: 0 100%; transition: background-size 250ms var(--ease), color 150ms; }
  .cat a:hover { color: var(--blue-ink); background-size: 100% 1px; }
  .free { font-size: 0.8rem; font-weight: 700; color: var(--ok); }

  /* Comparison */
  .cmp-wrap { overflow-x: auto; border-radius: var(--r-xl); background: #fff; box-shadow: var(--shadow); border: 1px solid var(--line); max-width: 60rem; margin-inline: auto; }
  .cmp { width: 100%; border-collapse: collapse; min-width: 40rem; }
  .cmp th, .cmp td { padding: 1rem 1.25rem; text-align: center; border-bottom: 1px solid var(--line); font-size: 0.95rem; }
  .cmp thead th { font-size: 0.8125rem; font-weight: 750; color: var(--muted); }
  .cmp tbody th { text-align: left; font-weight: 600; color: var(--ink); }
  .cmp tr:last-child th, .cmp tr:last-child td { border-bottom: 0; }
  .cmp .us { background: linear-gradient(180deg, rgba(0, 139, 248, 0.07), rgba(250, 15, 156, 0.07)); }
  .cmp thead .us { color: var(--ink); font-size: 1rem; font-weight: 850; }
  .yes { display: inline-grid; place-items: center; width: 1.8rem; height: 1.8rem; border-radius: 50%; background: var(--nova-btn); color: #fff; font-weight: 800; }
  .no { color: var(--line-strong); font-weight: 700; }
  .part { font-size: 0.8125rem; font-weight: 600; color: var(--subtle); }

  /* Posts */
  .posts { display: grid; gap: 1.25rem; }
  @media (min-width: 56rem) { .posts { grid-template-columns: repeat(3, 1fr); } }
  .post { display: grid; height: 100%; border-radius: var(--r-lg); overflow: hidden; background: #fff; border: 1px solid var(--line); text-decoration: none; color: inherit; transition: transform 220ms var(--ease), box-shadow 220ms var(--ease); }
  .post:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
