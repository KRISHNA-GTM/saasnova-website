---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import body from '../content/legal/terms.html?raw';
---
<Base title="Terms of Use" description="SaaSNova Terms of Use." noindex>
  <section class="page-hero">
    <div class="container-narrow">
      <Breadcrumbs items={[{ label: 'Terms of Use' }]} />
      <h1>Terms of Use</h1>
      <p class="muted updated">Last updated: March 2026</p>
    </div>
  </section>
  <section class="section">
    <div class="container-narrow prose legal" set:html={body} />
  </section>
</Base>
<style>
  .updated { margin-top: 0.75rem; }
  .legal :global(h2) { font-size: 1.5rem; }
</style>
